{
  "name": "mathema",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "sync": "node scripts/sync-lean-status.mjs && node scripts/build-content.mjs",
    "prebuild": "node scripts/validate.mjs && node scripts/build-content.mjs",
    "build": "vite build",
    "validate": "node scripts/validate.mjs",
    "test:invariants": "node scripts/test-invariants.mjs",
    "verify-lean-ci": "node scripts/sync-lean-status.mjs --after-lake-build && node scripts/build-content.mjs && node scripts/validate.mjs",
    "start": "node server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^2.0.0"
  }
}
